# Opcionales: definir en Vercel > Settings > Environment Variables.
# SITE_URL: URL HTTPS definitiva de ESTA web, sin ruta. Si se omite,
# el build usa VERCEL_PROJECT_PRODUCTION_URL automáticamente.
SITE_URL=
# Solo el código real entregado por Search Console, no la etiqueta HTML.
GOOGLE_SITE_VERIFICATION=
